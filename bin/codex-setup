#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-setup [--runtime-home <path>] [--variant <id>]
       codex-setup [--codex-home <path>] [--variant <id>]

Runs an interactive setup for the selected runtime variant and optional project
initialization.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VARIANTS_CONFIG="$TEMPLATE_DIR/variants/config.toml"
RUNTIME_HOME=""
VARIANT_ID=""
VARIANT_IDS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime-home|--codex-home)
      RUNTIME_HOME="$2"
      shift 2
      ;;
    --variant)
      VARIANT_ID="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -n "$RUNTIME_HOME" && -z "$VARIANT_ID" ]]; then
  echo "FAILED: --runtime-home requires --variant; each model has its own runtime home." >&2
  exit 1
fi

ask_yes_no() {
  local prompt="$1"
  local default_answer="$2"
  local answer
  local suffix

  if [[ "$default_answer" == "y" ]]; then
    suffix="[Y/n]"
  else
    suffix="[y/N]"
  fi

  while true; do
    printf "%s %s " "$prompt" "$suffix" >&2
    read -r answer
    answer="${answer:-$default_answer}"
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) echo "Lütfen y veya n girin." >&2 ;;
    esac
  done
}

ask_value() {
  local prompt="$1"
  local default_value="$2"
  local answer

  printf "%s [%s] " "$prompt" "$default_value" >&2
  read -r answer
  printf "%s" "${answer:-$default_value}"
}

default_variant() {
  awk -F= '
    $1 ~ /^[[:space:]]*default_variant[[:space:]]*$/ {
      value=$2
      gsub(/[[:space:]"]/, "", value)
      print value
      exit
    }
  ' "$VARIANTS_CONFIG"
}

variant_default_home() {
  local requested_id="$1"
  awk -v requested_id="$requested_id" '
    /^\[\[variants\]\]/ {
      if (active && default_home != "") {
        print default_home
        found=1
        exit
      }
      active=0
      default_home=""
      next
    }
    /^[[:space:]]*id[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      active=(value == requested_id)
      next
    }
    active && /^[[:space:]]*default_home[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      default_home=value
    }
    END {
      if (active && default_home != "" && !found) print default_home
    }
  ' "$VARIANTS_CONFIG"
}

expand_home_path() {
  local path="$1"
  case "$path" in
    "~") printf "%s" "$HOME" ;;
    "~/"*) printf "%s/%s" "$HOME" "${path#\~/}" ;;
    *) printf "%s" "$path" ;;
  esac
}

validate_runtime_registry() {
  local runtime_home="$1"
  local registry="$runtime_home/registry"

  if [[ -L "$runtime_home" || -L "$registry" ]]; then
    echo "FAILED: refusing symbolic link for runtime registry: $registry" >&2
    exit 1
  fi
  if [[ -e "$runtime_home" && ! -d "$runtime_home" ]]; then
    echo "FAILED: expected runtime home directory: $runtime_home" >&2
    exit 1
  fi
  mkdir -p "$runtime_home"
  if [[ -L "$runtime_home" || -L "$registry" ]]; then
    echo "FAILED: refusing symbolic link for runtime registry: $registry" >&2
    exit 1
  fi
  if [[ -e "$registry" && ! -d "$registry" ]]; then
    echo "FAILED: expected runtime registry directory: $registry" >&2
    exit 1
  fi
  mkdir -p "$registry"
}

safe_write_file() {
  local directory="$1"
  local filename="$2"
  local content="$3"

  python3 -c '
import os
import stat
import sys

directory, filename, content = sys.argv[1:]
if stat.S_ISLNK(os.lstat(directory).st_mode):
    raise SystemExit(f"FAILED: refusing symbolic link for runtime registry: {directory}")
directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    mode = 0o666
    preserve_mode = False
    try:
        target = os.stat(filename, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISLNK(target.st_mode):
            raise SystemExit(f"FAILED: refusing symbolic link for runtime registry file: {filename}")
        if not stat.S_ISREG(target.st_mode):
            raise SystemExit(f"FAILED: expected regular runtime registry file: {filename}")
        mode = stat.S_IMODE(target.st_mode)
        preserve_mode = True
    except FileNotFoundError:
        pass
    temporary = f".{filename}.{os.getpid()}.tmp"
    temporary_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=directory_fd)
    try:
        if preserve_mode:
            os.fchmod(temporary_fd, mode)
        payload = content.encode()
        offset = 0
        while offset < len(payload):
            offset += os.write(temporary_fd, payload[offset:])
        os.fsync(temporary_fd)
    finally:
        os.close(temporary_fd)
    os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
' "$directory" "$filename" "$content"
}

write_status_messages() {
  local target="$1"
  local error_msg="$2"
  local permission_msg="$3"
  local completed_msg="$4"
  local decision_msg="$5"

  safe_write_file "$(dirname "$target")" "$(basename "$target")" "$(cat <<EOF
# Status Messages

**Status:** Active

| State | Message |
|---|---|
| error | $error_msg |
| permission_required | $permission_msg |
| completed | $completed_msg |
| decision_required | $decision_msg |
| blocked | İlerleyemiyorum, kararını bekliyorum. |
EOF
  )"
}

write_setup_preferences() {
  local target="$1"
  local yolo_mode="$2"

  safe_write_file "$(dirname "$target")" "$(basename "$target")" "$(cat <<EOF
# Setup Preferences

**Status:** Active

## YOLO Mode

\`\`\`text
YOLO_MODE: $yolo_mode
\`\`\`

YOLO mode may allow lower-risk automation to proceed with fewer interruptions.

YOLO mode must not bypass approval for:

- \`DROP\`
- \`DELETE *\`
- \`TRUNCATE\`
- \`rm -rf\`
- \`git reset --hard\`
- \`git push --force\`
- adding dependencies
- changing API contracts
- DB schema changes
- auth/security code changes

If any of these are needed: stop, report, and wait for user approval.
EOF
  )"
}

echo "Codex setup"
echo "-----------"

if [[ -z "$VARIANT_ID" ]]; then
  CATALOG_VARIANTS=()
  while IFS=$'\t' read -r id _name _home; do CATALOG_VARIANTS+=("$id"); done < <("$TEMPLATE_DIR/bin/codex-user-install" --list-variants)
  if ask_yes_no "Tüm modeller kurulsun mu?" "y"; then
    VARIANT_IDS=("${CATALOG_VARIANTS[@]}")
  else
    for id in "${CATALOG_VARIANTS[@]}"; do
      if ask_yes_no "$id kurulsun mu?" "n"; then VARIANT_IDS+=("$id"); fi
    done
  fi
  if [[ ${#VARIANT_IDS[@]} -eq 0 ]]; then
    echo "No runtime variants selected; nothing changed."
    exit 0
  fi
else
  VARIANT_IDS=("$VARIANT_ID")
fi

RUNTIME_HOMES=()
for variant in "${VARIANT_IDS[@]}"; do
  DEFAULT_RUNTIME_HOME="$(variant_default_home "$variant")"
  selected_home="$(ask_value "$variant runtime home dizini" "${RUNTIME_HOME:-$DEFAULT_RUNTIME_HOME}")"
  selected_home="$(expand_home_path "$selected_home")"
  RUNTIME_HOMES+=("$selected_home")
  echo
  if ask_yes_no "$variant runtime template kurulsun mu?" "y"; then
    FORCE_FLAG=()
    if ask_yes_no "Mevcut template-managed dosyalar ezilsin mi?" "n"; then
      FORCE_FLAG=(--force)
    fi
    "$TEMPLATE_DIR/bin/codex-user-install" --runtime-home "$selected_home" --variant "$variant" "${FORCE_FLAG[@]}"
  fi
done

echo
if ask_yes_no "YOLO modu etkinleştirilsin mi?" "n"; then
  YOLO_MODE="enabled"
else
  YOLO_MODE="disabled"
fi

echo
echo "Durum mesajları için varsayılanlar kullanılacak. Enter ile kabul edebilir veya değiştirebilirsin."
ERROR_MSG="$(ask_value "Hata mesajı" "Hata oluştu, seni bekliyorum.")"
echo
PERMISSION_MSG="$(ask_value "İzin mesajı" "Devam etmek için izin vermelisin.")"
echo
COMPLETED_MSG="$(ask_value "Tamamlandı mesajı" "Görev tamamlandı, yeni talimatını bekliyorum.")"
echo
DECISION_MSG="$(ask_value "Karar mesajı" "Karar gerekiyor, seni bekliyorum.")"
echo

for runtime_home in "${RUNTIME_HOMES[@]}"; do
  validate_runtime_registry "$runtime_home"
done
for runtime_home in "${RUNTIME_HOMES[@]}"; do
  write_status_messages "$runtime_home/registry/STATUS_MESSAGES.md" "$ERROR_MSG" "$PERMISSION_MSG" "$COMPLETED_MSG" "$DECISION_MSG"
  write_setup_preferences "$runtime_home/registry/SETUP_PREFERENCES.md" "$YOLO_MODE"
  echo "Yazıldı: $runtime_home/registry/STATUS_MESSAGES.md"
  echo "Yazıldı: $runtime_home/registry/SETUP_PREFERENCES.md"
done

echo
if ask_yes_no "Bir proje içine CMA yapısı kurulsun mu?" "n"; then
  PROJECT_PATH="$(ask_value "Proje dizini" "/path/to/project")"
  echo
  echo "Proje kurulumu başlatılıyor. Komut kendi onayını ayrıca soracaktır."
  PROJECT_VARIANT_ARGS=()
  for variant in "${VARIANT_IDS[@]}"; do PROJECT_VARIANT_ARGS+=(--variant "$variant"); done
  "$TEMPLATE_DIR/bin/codex-project-init" "${PROJECT_VARIANT_ARGS[@]}" "$PROJECT_PATH"
fi

echo
echo "Kurulum tamamlandı."
