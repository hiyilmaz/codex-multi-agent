#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-setup [--runtime-home <path>] [--variant <id>]
       codex-setup [--codex-home <path>] [--variant <id>]

Runs an interactive setup for the selected runtime variant and optional project
initialization.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VARIANTS_CONFIG="$TEMPLATE_DIR/variants/config.toml"
RUNTIME_HOME=""
VARIANT_ID=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime-home|--codex-home)
      RUNTIME_HOME="$2"
      shift 2
      ;;
    --variant)
      VARIANT_ID="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

ask_yes_no() {
  local prompt="$1"
  local default_answer="$2"
  local answer
  local suffix

  if [[ "$default_answer" == "y" ]]; then
    suffix="[Y/n]"
  else
    suffix="[y/N]"
  fi

  while true; do
    printf "%s %s " "$prompt" "$suffix" >&2
    read -r answer
    answer="${answer:-$default_answer}"
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) echo "Lütfen y veya n girin." >&2 ;;
    esac
  done
}

ask_value() {
  local prompt="$1"
  local default_value="$2"
  local answer

  printf "%s [%s] " "$prompt" "$default_value" >&2
  read -r answer
  printf "%s" "${answer:-$default_value}"
}

default_variant() {
  awk -F= '
    $1 ~ /^[[:space:]]*default_variant[[:space:]]*$/ {
      value=$2
      gsub(/[[:space:]"]/, "", value)
      print value
      exit
    }
  ' "$VARIANTS_CONFIG"
}

variant_default_home() {
  local requested_id="$1"
  awk -v requested_id="$requested_id" '
    /^\[\[variants\]\]/ {
      if (active && default_home != "") {
        print default_home
        found=1
        exit
      }
      active=0
      default_home=""
      next
    }
    /^[[:space:]]*id[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      active=(value == requested_id)
      next
    }
    active && /^[[:space:]]*default_home[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      default_home=value
    }
    END {
      if (active && default_home != "" && !found) print default_home
    }
  ' "$VARIANTS_CONFIG"
}

expand_home_path() {
  local path="$1"
  case "$path" in
    "~") printf "%s" "$HOME" ;;
    "~/"*) printf "%s/%s" "$HOME" "${path#\~/}" ;;
    *) printf "%s" "$path" ;;
  esac
}

write_status_messages() {
  local target="$1"
  local error_msg="$2"
  local permission_msg="$3"
  local completed_msg="$4"
  local decision_msg="$5"

  mkdir -p "$(dirname "$target")"
  cat > "$target" <<EOF
# Status Messages

**Status:** Active

| State | Message |
|---|---|
| error | $error_msg |
| permission_required | $permission_msg |
| completed | $completed_msg |
| decision_required | $decision_msg |
| blocked | İlerleyemiyorum, kararını bekliyorum. |
EOF
}

write_setup_preferences() {
  local target="$1"
  local yolo_mode="$2"

  mkdir -p "$(dirname "$target")"
  cat > "$target" <<EOF
# Setup Preferences

**Status:** Active

## YOLO Mode

\`\`\`text
YOLO_MODE: $yolo_mode
\`\`\`

YOLO mode may allow lower-risk automation to proceed with fewer interruptions.

YOLO mode must not bypass approval for:

- \`DROP\`
- \`DELETE *\`
- \`TRUNCATE\`
- \`rm -rf\`
- \`git reset --hard\`
- \`git push --force\`
- adding dependencies
- changing API contracts
- DB schema changes
- auth/security code changes

If any of these are needed: stop, report, and wait for user approval.
EOF
}

echo "Codex setup"
echo "-----------"

if [[ -z "$VARIANT_ID" ]]; then
  VARIANT_ID="$(ask_value "Runtime versiyonu" "$(default_variant)")"
fi

DEFAULT_RUNTIME_HOME="$(variant_default_home "$VARIANT_ID")"
RUNTIME_HOME="$(ask_value "Runtime home dizini" "${RUNTIME_HOME:-$DEFAULT_RUNTIME_HOME}")"
RUNTIME_HOME="$(expand_home_path "$RUNTIME_HOME")"
echo

if ask_yes_no "Runtime template kurulsun mu?" "y"; then
  FORCE_FLAG=()
  VARIANT_FLAG=()
  VARIANT_FLAG=(--variant "$VARIANT_ID")
  RUNTIME_HOME_FLAG=(--runtime-home "$RUNTIME_HOME")
  if ask_yes_no "Mevcut template-managed dosyalar ezilsin mi?" "n"; then
    FORCE_FLAG=(--force)
  fi
  "$TEMPLATE_DIR/bin/codex-user-install" "${RUNTIME_HOME_FLAG[@]}" "${VARIANT_FLAG[@]}" "${FORCE_FLAG[@]}"
fi

echo
if ask_yes_no "YOLO modu etkinleştirilsin mi?" "n"; then
  YOLO_MODE="enabled"
else
  YOLO_MODE="disabled"
fi

echo
echo "Durum mesajları için varsayılanlar kullanılacak. Enter ile kabul edebilir veya değiştirebilirsin."
ERROR_MSG="$(ask_value "Hata mesajı" "Hata oluştu, seni bekliyorum.")"
echo
PERMISSION_MSG="$(ask_value "İzin mesajı" "Devam etmek için izin vermelisin.")"
echo
COMPLETED_MSG="$(ask_value "Tamamlandı mesajı" "Görev tamamlandı, yeni talimatını bekliyorum.")"
echo
DECISION_MSG="$(ask_value "Karar mesajı" "Karar gerekiyor, seni bekliyorum.")"
echo

write_status_messages "$RUNTIME_HOME/registry/STATUS_MESSAGES.md" "$ERROR_MSG" "$PERMISSION_MSG" "$COMPLETED_MSG" "$DECISION_MSG"
write_setup_preferences "$RUNTIME_HOME/registry/SETUP_PREFERENCES.md" "$YOLO_MODE"

echo "Yazıldı: $RUNTIME_HOME/registry/STATUS_MESSAGES.md"
echo "Yazıldı: $RUNTIME_HOME/registry/SETUP_PREFERENCES.md"

echo
if ask_yes_no "Bir proje içine Codex yapısı kurulsun mu?" "n"; then
  PROJECT_PATH="$(ask_value "Proje dizini" "/path/to/project")"
  echo
  echo "Proje kurulumu başlatılıyor. Komut kendi onayını ayrıca soracaktır."
  "$TEMPLATE_DIR/bin/codex-project-init" "$PROJECT_PATH"
fi

echo
echo "Kurulum tamamlandı."
