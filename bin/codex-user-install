#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-user-install [--runtime-home <path>] [--variant <id>] [--force]
       codex-user-install [--codex-home <path>] [--variant <id>] [--force]
       codex-user-install --list-variants

Installs a portable user-global runtime template.

Behavior:
  - uses the selected variant's default home unless a target home is provided
  - creates agents, skills, rules, registry, prompts, and bin directories
  - installs the selected provider's declared policy and settings files
  - installs template agents, skills, and registry files
  - installs variant launchers into the target runtime bin directory
  - rewrites installed template paths to the selected target home
  - does not overwrite existing files unless --force is provided
  - asks for a variant when --variant is not provided and stdin is interactive
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VARIANTS_CONFIG="$REPO_ROOT/variants/config.toml"
RUNTIME_HOME=""
FORCE="false"
VARIANT_ID=""
INSTALLED_FILES=()

default_variant() {
  awk -F= '
    $1 ~ /^[[:space:]]*default_variant[[:space:]]*$/ {
      value=$2
      gsub(/[[:space:]"]/, "", value)
      print value
      exit
    }
  ' "$VARIANTS_CONFIG"
}

variant_rows() {
  awk '
    /^\[\[variants\]\]/ {
      if (id != "") print id "|" name "|" home "|" default_home "|" launcher "|" launcher_name "|" policy_file "|" settings_file "|" agent_format
      id=""; name=""; home=""; default_home=""; launcher=""; launcher_name=""; policy_file=""; settings_file=""; agent_format=""
      next
    }
    /^[[:space:]]*[a-z_]+[[:space:]]*=/ {
      key=$0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]]/, "", key)
      value=$0; sub(/^[^=]*=/, "", value); gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      if (key == "id") id=value
      else if (key == "name") name=value
      else if (key == "home") home=value
      else if (key == "default_home") default_home=value
      else if (key == "launcher") launcher=value
      else if (key == "launcher_name") launcher_name=value
      else if (key == "policy_file") policy_file=value
      else if (key == "settings_file") settings_file=value
      else if (key == "agent_format") agent_format=value
    }
    END {
      if (id != "") print id "|" name "|" home "|" default_home "|" launcher "|" launcher_name "|" policy_file "|" settings_file "|" agent_format
    }
  ' "$VARIANTS_CONFIG"
}

list_variants() {
  variant_rows | while IFS='|' read -r id name home default_home launcher launcher_name policy_file settings_file agent_format; do
    printf "%s\t%s\t%s\t%s\n" "$id" "$name" "$home" "$default_home"
  done
}

variant_record() {
  local requested_id="$1"
  variant_rows | awk -F '|' -v requested_id="$requested_id" '$1 == requested_id { print; found=1 } END { exit(found ? 0 : 1) }'
}

expand_home_path() {
  local path="$1"
  case "$path" in
    "~") printf "%s" "$HOME" ;;
    "~/"*) printf "%s/%s" "$HOME" "${path#\~/}" ;;
    *) printf "%s" "$path" ;;
  esac
}

select_variant() {
  local default_id="$1"
  local answer

  if [[ -n "$VARIANT_ID" ]]; then
    printf "%s" "$VARIANT_ID"
    return
  fi

  if [[ ! -t 0 ]]; then
    printf "%s" "$default_id"
    return
  fi

  echo "Kurulum versiyonu seç:" >&2
  list_variants | while IFS=$'\t' read -r id name home default_home; do
    if [[ "$id" == "$default_id" ]]; then
      printf "  - %s: %s (default) [%s]\n" "$id" "$name" "$default_home" >&2
    else
      printf "  - %s: %s [%s]\n" "$id" "$name" "$default_home" >&2
    fi
  done
  printf "Variant [%s] " "$default_id" >&2
  read -r answer
  printf "%s" "${answer:-$default_id}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime-home|--codex-home)
      RUNTIME_HOME="$2"
      shift 2
      ;;
    --variant)
      VARIANT_ID="$2"
      shift 2
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    --list-variants)
      list_variants
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ ! -f "$VARIANTS_CONFIG" ]]; then
  echo "FAILED: missing variants config: $VARIANTS_CONFIG" >&2
  exit 1
fi

DEFAULT_VARIANT="$(default_variant)"
if [[ -z "$DEFAULT_VARIANT" ]]; then
  echo "FAILED: missing default_variant in $VARIANTS_CONFIG" >&2
  exit 1
fi

VARIANT_ID="$(select_variant "$DEFAULT_VARIANT")"
VARIANT_RECORD="$(variant_record "$VARIANT_ID" || true)"
if [[ -z "$VARIANT_RECORD" ]]; then
  echo "FAILED: unknown variant: $VARIANT_ID" >&2
  echo "Available variants:" >&2
  list_variants >&2
  exit 1
fi

IFS='|' read -r _VARIANT_ID VARIANT_NAME SOURCE_RELATIVE DEFAULT_RUNTIME_HOME VARIANT_LAUNCHER_RELATIVE VARIANT_LAUNCHER_NAME POLICY_FILE SETTINGS_FILE AGENT_FORMAT <<< "$VARIANT_RECORD"

for required_value in "$VARIANT_NAME" "$SOURCE_RELATIVE" "$DEFAULT_RUNTIME_HOME" "$POLICY_FILE" "$SETTINGS_FILE" "$AGENT_FORMAT"; do
  if [[ -z "$required_value" ]]; then
    echo "FAILED: incomplete metadata for variant: $VARIANT_ID" >&2
    exit 1
  fi
done

case "$SOURCE_RELATIVE" in
  /*|../*|*/../*|*/..) echo "FAILED: unsafe variant home: $SOURCE_RELATIVE" >&2; exit 1 ;;
esac
case "$POLICY_FILE|$SETTINGS_FILE" in
  */*) echo "FAILED: policy and settings metadata must be file names" >&2; exit 1 ;;
esac
case "$AGENT_FORMAT" in
  toml|markdown) ;;
  *) echo "FAILED: unsupported agent format: $AGENT_FORMAT" >&2; exit 1 ;;
esac
if [[ -n "$VARIANT_LAUNCHER_RELATIVE" || -n "$VARIANT_LAUNCHER_NAME" ]]; then
  if [[ -z "$VARIANT_LAUNCHER_RELATIVE" || -z "$VARIANT_LAUNCHER_NAME" ]]; then
    echo "FAILED: incomplete launcher metadata for variant: $VARIANT_ID" >&2
    exit 1
  fi
  case "$VARIANT_LAUNCHER_RELATIVE" in
    /*|../*|*/../*|*/..) echo "FAILED: unsafe launcher path: $VARIANT_LAUNCHER_RELATIVE" >&2; exit 1 ;;
  esac
  case "$VARIANT_LAUNCHER_NAME" in
    ""|.|..|*/*|*[!A-Za-z0-9._-]*) echo "FAILED: unsafe launcher name: $VARIANT_LAUNCHER_NAME" >&2; exit 1 ;;
  esac
fi

if [[ -z "$RUNTIME_HOME" ]]; then
  if [[ "$VARIANT_ID" == "codex" && -n "${CODEX_HOME:-}" ]]; then
    RUNTIME_HOME="$CODEX_HOME"
  else
    RUNTIME_HOME="$DEFAULT_RUNTIME_HOME"
  fi
fi
RUNTIME_HOME="$(expand_home_path "$RUNTIME_HOME")"

SOURCE_DIR="$REPO_ROOT/$SOURCE_RELATIVE"
if [[ ! -d "$SOURCE_DIR" ]]; then
  echo "FAILED: missing template directory: $SOURCE_DIR" >&2
  exit 1
fi
if [[ ! -f "$SOURCE_DIR/$POLICY_FILE" || ! -f "$SOURCE_DIR/$SETTINGS_FILE" || ! -f "$SOURCE_DIR/README.md" ]]; then
  echo "FAILED: variant $VARIANT_ID is missing declared policy, settings, or README" >&2
  exit 1
fi
if [[ -n "$VARIANT_LAUNCHER_RELATIVE" && ! -f "$REPO_ROOT/$VARIANT_LAUNCHER_RELATIVE" ]]; then
  echo "FAILED: missing variant launcher: $VARIANT_LAUNCHER_RELATIVE" >&2
  exit 1
fi

if [[ "$VARIANT_ID" == "claude" ]]; then
  RESOLVED_RUNTIME_HOME="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$RUNTIME_HOME")"
  RESOLVED_NATIVE_CLAUDE_HOME="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$HOME/.claude")"
else
  RESOLVED_RUNTIME_HOME=""
  RESOLVED_NATIVE_CLAUDE_HOME=""
fi

if [[ "$VARIANT_ID" == "claude" && "$RESOLVED_RUNTIME_HOME" == "$RESOLVED_NATIVE_CLAUDE_HOME" ]]; then
  NATIVE_ACTIVATOR="$REPO_ROOT/bin/claude-native-activate"
  if [[ ! -x "$NATIVE_ACTIVATOR" ]]; then
    echo "FAILED: missing executable native Claude activator: $NATIVE_ACTIVATOR" >&2
    exit 1
  fi
  NATIVE_ARGS=(--runtime-home "$HOME/.claude")
  if [[ "$FORCE" == "true" ]]; then
    NATIVE_ARGS+=(--force)
  fi
  exec "$NATIVE_ACTIVATOR" "${NATIVE_ARGS[@]}"
fi

if [[ -L "$RUNTIME_HOME" ]]; then
  echo "FAILED: refusing symbolic link for runtime home: $RUNTIME_HOME" >&2
  exit 1
fi

mkdir -p "$RUNTIME_HOME"
RUNTIME_HOME="$(cd "$RUNTIME_HOME" && pwd)"

validate_managed_directory() {
  local directory="$1"
  local found_link=""

  if [[ -L "$directory" ]]; then
    echo "FAILED: refusing symbolic link for managed directory: $directory" >&2
    exit 1
  fi
  if [[ -e "$directory" && ! -d "$directory" ]]; then
    echo "FAILED: managed directory path is not a directory: $directory" >&2
    exit 1
  fi
  if [[ -d "$directory" ]]; then
    found_link="$(find "$directory" -type l -print -quit)"
    if [[ -n "$found_link" ]]; then
      echo "FAILED: refusing symbolic link inside managed directory: $found_link" >&2
      exit 1
    fi
  fi
}

assert_safe_target_path() {
  local target_path="$1"
  local relative_path=""
  local parent_path=""
  local current_path="$RUNTIME_HOME"
  local component=""
  local components=()

  case "$target_path" in
    "$RUNTIME_HOME"/*) ;;
    *) echo "FAILED: target escapes runtime home: $target_path" >&2; exit 1 ;;
  esac

  relative_path="${target_path#$RUNTIME_HOME/}"
  parent_path="$(dirname "$relative_path")"
  if [[ "$parent_path" != "." ]]; then
    IFS='/' read -r -a components <<< "$parent_path"
    for component in "${components[@]}"; do
      current_path="$current_path/$component"
      if [[ -L "$current_path" ]]; then
        echo "FAILED: refusing symbolic link in target path: $current_path" >&2
        exit 1
      fi
      if [[ -e "$current_path" && ! -d "$current_path" ]]; then
        echo "FAILED: target parent is not a directory: $current_path" >&2
        exit 1
      fi
    done
  fi
}

for managed_name in agents skills rules registry prompts bin; do
  validate_managed_directory "$RUNTIME_HOME/$managed_name"
done

install_file() {
  local source_path="$1"
  local target_path="$2"

  assert_safe_target_path "$target_path"

  if [[ -L "$target_path" ]]; then
    echo "FAILED: refusing to overwrite symbolic link: $target_path" >&2
    exit 1
  fi

  if [[ -e "$target_path" && "$FORCE" != "true" ]]; then
    echo "Skipped existing: $target_path"
    return
  fi

  mkdir -p "$(dirname "$target_path")"
  cp "$source_path" "$target_path"
  INSTALLED_FILES+=("$target_path")
  echo "Installed: $target_path"
}

install_tree_files() {
  local source_root="$1"
  local target_root="$2"

  if [[ ! -d "$source_root" ]]; then
    return
  fi

  while IFS= read -r source_path; do
    local rel_path="${source_path#$source_root/}"
    install_file "$source_path" "$target_root/$rel_path"
  done < <(find "$source_root" -type f | sort)
}

rewrite_installed_variant_paths() {
  local source_home="$1"
  local target_home="$2"
  local source_launcher="$3"
  local target_launcher_name="$4"
  local target_launcher=""

  if [[ -n "$source_launcher" ]]; then
    target_launcher="$target_home/bin/$target_launcher_name"
  fi

  for target_path in "${INSTALLED_FILES[@]}"; do
    [[ -f "$target_path" ]] || continue

    SOURCE_HOME="$source_home" \
    TARGET_HOME="$target_home" \
    SOURCE_LAUNCHER="$source_launcher" \
    TARGET_LAUNCHER="$target_launcher" \
    perl -0pi -e '
      my $source_home = $ENV{"SOURCE_HOME"};
      my $target_home = $ENV{"TARGET_HOME"};
      my $source_launcher = $ENV{"SOURCE_LAUNCHER"};
      my $target_launcher = $ENV{"TARGET_LAUNCHER"};

      s/\Q$source_home\/agents\E/$target_home\/agents/g;
      s/\Q$source_home\/skills\E/$target_home\/skills/g;
      s/\Q$source_home\/registry\E/$target_home\/registry/g;
      s/\Q$source_home\/prompts\E/$target_home\/prompts/g;
      s/\Q$source_home\E/$target_home/g;

      if ($source_launcher ne "" && $target_launcher ne "") {
        s/\Q$source_launcher\E/$target_launcher/g;
      }
    ' "$target_path"
  done
}

install_variant_launcher() {
  local source_launcher="$1"
  local target_home="$2"
  local target_launcher_name="$3"

  [[ -n "$source_launcher" ]] || return 0

  if [[ -z "$target_launcher_name" ]]; then
    target_launcher_name="$(basename "$source_launcher")"
  fi

  local target_launcher="$target_home/bin/$target_launcher_name"
  local target_existed="false"
  [[ -e "$target_launcher" ]] && target_existed="true"
  install_file "$REPO_ROOT/$source_launcher" "$target_launcher"
  if [[ "$target_existed" != "true" || "$FORCE" == "true" ]]; then
    chmod +x "$target_launcher"
  fi
}

for managed_name in agents skills rules registry prompts bin; do
  mkdir -p "$RUNTIME_HOME/$managed_name"
done

install_file "$SOURCE_DIR/$POLICY_FILE" "$RUNTIME_HOME/$POLICY_FILE"
install_file "$SOURCE_DIR/$SETTINGS_FILE" "$RUNTIME_HOME/$SETTINGS_FILE"
install_file "$SOURCE_DIR/README.md" "$RUNTIME_HOME/README.md"
install_tree_files "$SOURCE_DIR/agents" "$RUNTIME_HOME/agents"
install_tree_files "$SOURCE_DIR/skills" "$RUNTIME_HOME/skills"
install_tree_files "$SOURCE_DIR/registry" "$RUNTIME_HOME/registry"
install_tree_files "$SOURCE_DIR/prompts" "$RUNTIME_HOME/prompts"
install_variant_launcher "$VARIANT_LAUNCHER_RELATIVE" "$RUNTIME_HOME" "$VARIANT_LAUNCHER_NAME"

rewrite_installed_variant_paths "$SOURCE_RELATIVE" "$RUNTIME_HOME" "$VARIANT_LAUNCHER_RELATIVE" "$VARIANT_LAUNCHER_NAME"

echo "Variant installed: $VARIANT_ID"
echo "Runtime home installed at: $RUNTIME_HOME"
