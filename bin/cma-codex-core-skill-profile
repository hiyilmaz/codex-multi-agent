def validate_registry_authority(registry: dict[str, Any]) -> list[dict[str, Any]]:
    try:
        script = Path(__file__).resolve(strict=True)
        bin_root = script.parent
        path = bin_root / "cma-core-skill-governance"
        if path.is_symlink():
            raise InputError("canonical registry validator unavailable or invalid")
        resolved = path.resolve(strict=True)
        metadata = resolved.stat()
        if (
            resolved != path
            or resolved.parent != bin_root
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_size > 1_048_576
        ):
            raise InputError("canonical registry validator unavailable or invalid")
        source = resolved.read_bytes()
        namespace: dict[str, Any] = {
            "__file__": str(resolved),
            "__name__": "cma_core_skill_governance",
            "__package__": None,
        }
        exec(compile(source, str(resolved), "exec"), namespace)
        validator = namespace.get("validate_registry")
        if not callable(validator):
            raise InputError("canonical registry validator unavailable or invalid")
        findings = validator(registry)
        if not isinstance(findings, list):
            raise InputError("canonical registry validator unavailable or invalid")
        return findings
    except InputError:
        raise
    except Exception:
        raise InputError("canonical registry validator unavailable or invalid") from None


def validate_profile(profile: dict[str, Any], registry: dict[str, Any]) -> list[dict[str, Any]]:
    findings = validate_registry_authority(registry)
    if set(profile) != TOP_LEVEL_FIELDS:
        findings.append(finding("INVALID_PROFILE_SCHEMA", "top_level_fields", sorted(profile)))
    for field, expected in (
        ("schema_version", "cma-codex-core-skill-profile/v1"),
        ("platform", "codex"),
        ("profile_version", "1.0.0"),
    ):
        if not strict_equal(expected, profile.get(field)):
            findings.append(finding("INVALID_PROFILE_SCHEMA", field, profile.get(field)))

    mappings = profile.get("field_mappings")
    if not isinstance(mappings, list):
        findings.append(finding("INVALID_PROFILE_SCHEMA", "field_mappings"))
        mappings = []
    names = [item.get("canonical_field") for item in mappings if isinstance(item, dict)]
    for name in CANONICAL_FIELDS:
        count = names.count(name)
        if count == 0:
            findings.append(finding("MISSING_MAPPING", name))
        elif count > 1:
            findings.append(finding("DUPLICATE_MAPPING", name))
    for index, item in enumerate(mappings):
        if not isinstance(item, dict) or set(item) != {
            "canonical_field", "canonical_source", "codex_targets"
        }:
            findings.append(finding("UNKNOWN_MAPPING", f"field_mappings[{index}]"))
            continue
        name = item["canonical_field"]
        if not isinstance(name, str):
            findings.append(
                finding("UNKNOWN_MAPPING", f"field_mappings[{index}].canonical_field")
            )
            continue
        if name not in MAPPING_CONTRACT:
            findings.append(finding("UNKNOWN_MAPPING", str(name)))
            continue
        expected_source, expected_targets = MAPPING_CONTRACT[name]
        if not strict_equal(expected_source, item.get("canonical_source")):
            findings.append(finding("CANONICAL_AUTHORITY_VIOLATION", name))
        if not strict_equal(expected_targets, item.get("codex_targets")):
            findings.append(finding("UNSUPPORTED_CODEX_MAPPING", name))

    for field, (expected, code) in expected_sections().items():
        if not strict_equal(expected, profile.get(field)):
            error_field = field
            if field == "activation":
                observed = profile.get(field)
                if isinstance(observed, dict) and observed.get("disabled_core_ids"):
                    findings.append(finding("CORE_DISABLE_FORBIDDEN", "activation.disabled_core_ids"))
                implicit = observed.get("implicit_invocation") if isinstance(observed, dict) else None
                if isinstance(implicit, dict) and not strict_equal(
                    True, implicit.get("allow_implicit_invocation")
                ):
                    error_field = "activation.implicit_invocation.allow_implicit_invocation"
            elif field == "semantic_parity":
                error_field = "semantic_parity.capability_dependency_independent"
            elif field == "discovery":
                error_field = "discovery.scopes"
            elif field == "codex_metadata":
                error_field = "codex_metadata.allowed_interface_fields"
            findings.append(finding(code, error_field))
    return findings


def canonical_fingerprint(
    profile: dict[str, Any],
    registry: dict[str, Any],
    native_metadata: dict[str, Any] | None = None,
) -> str:
    findings = validate_profile(profile, registry)
    if findings:
        raise InputError(f"invalid profile: {findings[0]['code']}")
    metadata = native_metadata or {}
    if set(metadata) - {"interface"} or not isinstance(metadata.get("interface", {}), dict):
        raise InputError("unsupported native metadata")
    interface = metadata.get("interface", {})
    if any(key not in UI_FIELDS for key in interface):
        raise InputError("behavioral or unknown interface metadata")
    if not all(isinstance(value, str) for value in interface.values()):
        raise InputError("interface metadata values must be strings")
    payload = {
        "mappings": profile["field_mappings"],
        "activation": profile["activation"],
        "unavailable": profile["tool_unavailable_behavior"],
        "routing": profile["global_instructions"],
        "registry_skills": registry["skills"],
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def emit(status: str, success: bool, findings: list[dict[str, Any]]) -> None:
    print(json.dumps({"findings": findings, "status": status, "success": success}, sort_keys=True, separators=(",", ":")))


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only CMA Codex core-skill profile validation.")
    commands = parser.add_subparsers(dest="command", required=True)
    validate = commands.add_parser("validate")
    validate.add_argument("--profile", required=True, type=Path)
    validate.add_argument("--registry", required=True, type=Path)
    args = parser.parse_args()
    try:
        findings = validate_profile(load_json(args.profile), load_json(args.registry))
    except InputError as error:
        emit("invalid", False, [finding("INVALID_INPUT", observed=str(error))])
        return 2
    if findings:
        emit("failed", False, findings)
        return 1
    emit("passed", True, [])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
