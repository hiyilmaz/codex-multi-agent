#!/usr/bin/env python3
"""Read-only validation for the canonical CMA core-skill registry."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any

PLATFORMS = ("codex", "claude", "opencode")
EXPECTED_CORE_IDS = (
    "graphify", "serena", "ast-grep", "deepwiki", "github",
    "opengrep", "osv-scanner", "betterleaks", "cplt", "context7",
)
TOP_LEVEL_FIELDS = {
    "schema_version", "standard", "platforms", "policies",
    "protected_core_ids", "skills",
}
SKILL_FIELDS = {
    "id", "display_name", "capability_category", "core", "protected",
    "semantic_version", "capability_status", "tool_dependency",
}
SEMANTIC_FIELDS = (
    "display_name", "capability_category", "core", "protected",
    "semantic_version", "capability_status", "tool_dependency.tool_id",
    "tool_dependency.mode",
)
POLICIES = {
    "removal": "explicit-user-approval-required",
    "automatic_pruning": False,
    "semantic_parity": "required",
    "parity_basis": "normalized-semantics",
    "byte_identity_required": False,
    "custom_skills": "outside-core-registry-preserve-unmanaged",
}
ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SEMVER_PATTERN = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-((?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
    r"(?:\.(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*))*))?"
    r"(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?$"
)
class InputError(ValueError):
    """Raised for malformed input rather than governance findings."""
def finding(
    code: str,
    *,
    skill_id: str | None = None,
    platform: str | None = None,
    field: str | None = None,
    expected: Any = None,
    observed: Any = None,
    approval_required: bool = False,
) -> dict[str, Any]:
    result: dict[str, Any] = {
        "code": code,
        "approval_required": approval_required,
    }
    for key, value in (
        ("skill_id", skill_id),
        ("platform", platform),
        ("field", field),
        ("expected", expected),
        ("observed", observed),
    ):
        if value is not None:
            result[key] = value
    return result
def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise InputError(f"duplicate JSON key: {key}")
        result[key] = value
    return result
def load_json(path: Path) -> dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle, object_pairs_hook=unique_object)
    except (OSError, json.JSONDecodeError, UnicodeError, InputError) as error:
        raise InputError(f"invalid JSON input {path}: {error}") from error
    if not isinstance(data, dict):
        raise InputError(f"JSON input must be an object: {path}")
    return data
def duplicate_ids(records: list[Any]) -> set[str]:
    seen: set[str] = set()
    duplicates: set[str] = set()
    for record in records:
        if isinstance(record, dict) and isinstance(record.get("id"), str):
            skill_id = record["id"]
            if skill_id in seen:
                duplicates.add(skill_id)
            seen.add(skill_id)
    return duplicates
def field_value(record: dict[str, Any], field: str) -> Any:
    value: Any = record
    for component in field.split("."):
        if not isinstance(value, dict):
            return None
        value = value.get(component)
    return value
def strict_equal(expected: Any, observed: Any) -> bool:
    if type(expected) is not type(observed):
        return False
    if isinstance(expected, dict):
        return expected.keys() == observed.keys() and all(
            strict_equal(value, observed[key]) for key, value in expected.items()
        )
    if isinstance(expected, list):
        return len(expected) == len(observed) and all(
            strict_equal(left, right) for left, right in zip(expected, observed)
        )
    return expected == observed
def validate_registry(data: dict[str, Any]) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    if set(data) != TOP_LEVEL_FIELDS:
        findings.append(
            finding(
                "INVALID_REGISTRY_SCHEMA",
                field="top_level_fields",
                expected=sorted(TOP_LEVEL_FIELDS),
                observed=sorted(data),
            )
        )
    for field, expected in (
        ("schema_version", "cma-core-skills/v1"),
        ("standard", "STANDARD.md"),
        ("platforms", list(PLATFORMS)),
        ("policies", POLICIES),
    ):
        if not strict_equal(expected, data.get(field)):
            findings.append(
                finding(
                    "INVALID_REGISTRY_POLICY",
                    field=field,
                    expected=expected,
                    observed=data.get(field),
                )
            )

    records = data.get("skills")
    protected_ids = data.get("protected_core_ids")
    if not isinstance(records, list):
        findings.append(
            finding("INVALID_REGISTRY_SCHEMA", field="skills", expected="array")
        )
        records = []
    if not isinstance(protected_ids, list) or not all(
        isinstance(item, str) for item in protected_ids
    ):
        findings.append(
            finding(
                "INVALID_REGISTRY_SCHEMA",
                field="protected_core_ids",
                expected="array of strings",
            )
        )
        protected_ids = []
    if len(protected_ids) != len(set(protected_ids)):
        findings.append(finding("DUPLICATE_ID", field="protected_core_ids"))

    for skill_id in sorted(duplicate_ids(records)):
        findings.append(finding("DUPLICATE_ID", skill_id=skill_id, field="id"))

    observed_ids: list[str] = []
    for index, record in enumerate(records):
        if not isinstance(record, dict):
            findings.append(
                finding(
                    "INVALID_CORE_METADATA",
                    field=f"skills[{index}]",
                    expected="object",
                    observed=type(record).__name__,
                )
            )
            continue
        skill_id = record.get("id")
        label = skill_id if isinstance(skill_id, str) else f"skills[{index}]"
        if set(record) != SKILL_FIELDS:
            findings.append(
                finding(
                    "INVALID_CORE_METADATA",
                    skill_id=label,
                    field="fields",
                    expected=sorted(SKILL_FIELDS),
                    observed=sorted(record),
                )
            )
        if not isinstance(skill_id, str) or not ID_PATTERN.fullmatch(skill_id):
            findings.append(
                finding(
                    "INVALID_CORE_METADATA",
                    skill_id=label,
                    field="id",
                    expected="lowercase kebab-case",
                    observed=skill_id,
                )
            )
        else:
            observed_ids.append(skill_id)
        for field in ("display_name", "capability_category"):
            value = record.get(field)
            if not isinstance(value, str) or not value.strip():
                findings.append(
                    finding(
                        "INVALID_CORE_METADATA",
                        skill_id=label,
                        field=field,
                        expected="non-empty string",
                        observed=value,
                    )
                )
        for field in ("core", "protected"):
            if record.get(field) is not True:
                findings.append(
                    finding(
                        "INVALID_CORE_METADATA",
                        skill_id=label,
                        field=field,
                        expected=True,
                        observed=record.get(field),
                    )
                )
        version = record.get("semantic_version")
        if not isinstance(version, str) or not SEMVER_PATTERN.fullmatch(version):
            findings.append(
                finding(
                    "INVALID_SEMVER",
                    skill_id=label,
                    field="semantic_version",
                    expected="SemVer 2.0.0",
                    observed=version,
                )
            )
        expected_status = "required" if skill_id in EXPECTED_CORE_IDS else None
        if record.get("capability_status") != expected_status:
            findings.append(
                finding(
                    "INVALID_CORE_METADATA",
                    skill_id=label,
                    field="capability_status",
                    expected=expected_status,
                    observed=record.get("capability_status"),
                )
            )
        dependency = record.get("tool_dependency")
        if not isinstance(dependency, dict) or set(dependency) != {"tool_id", "mode"}:
            findings.append(
                finding(
                    "INVALID_CORE_METADATA",
                    skill_id=label,
                    field="tool_dependency",
                    expected=["mode", "tool_id"],
                    observed=dependency,
                )
            )
        else:
            tool_id = dependency.get("tool_id")
            if not isinstance(tool_id, str) or not ID_PATTERN.fullmatch(tool_id):
                findings.append(
                    finding(
                        "INVALID_CORE_METADATA",
                        skill_id=label,
                        field="tool_dependency.tool_id",
                        expected="lowercase kebab-case",
                        observed=tool_id,
                    )
                )
            if dependency.get("mode") != "required":
                findings.append(
                    finding(
                        "INVALID_CORE_METADATA",
                        skill_id=label,
                        field="tool_dependency.mode",
                        expected="required",
                        observed=dependency.get("mode"),
                    )
                )

    protected_set = set(protected_ids)
    observed_set = set(observed_ids)
    expected_set = set(EXPECTED_CORE_IDS)
    for skill_id in sorted(expected_set - observed_set):
        findings.append(finding("MISSING_PROTECTED", skill_id=skill_id))
    for skill_id in sorted(observed_set - expected_set):
        findings.append(
            finding(
                "UNEXPECTED_CORE",
                skill_id=skill_id,
                field="protected_core_ids",
            )
        )
    for skill_id in sorted(expected_set - protected_set):
        findings.append(
            finding(
                "MISSING_PROTECTED",
                skill_id=skill_id,
                field="protected_core_ids",
            )
        )
    for skill_id in sorted(protected_set - expected_set):
        findings.append(
            finding(
                "UNEXPECTED_CORE",
                skill_id=skill_id,
                field="protected_core_ids",
            )
        )
    return findings
def compare_registries(
    baseline: dict[str, Any], candidate: dict[str, Any]
) -> list[dict[str, Any]]:
    baseline_findings = validate_registry(baseline)
    findings = baseline_findings + validate_registry(candidate)
    if baseline_findings:
        return findings
    if not isinstance(candidate.get("skills"), list):
        return findings
    baseline_records = {item["id"]: item for item in baseline["skills"]}
    candidate_records = {
        item["id"]: item
        for item in candidate["skills"]
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    for skill_id in sorted(baseline_records.keys() - candidate_records.keys()):
        findings.append(
            finding(
                "REMOVAL_REQUIRES_APPROVAL",
                skill_id=skill_id,
                approval_required=True,
            )
        )
    for skill_id in sorted(candidate_records.keys() - baseline_records.keys()):
        findings.append(
            finding(
                "REGISTRY_DRIFT",
                skill_id=skill_id,
                field="record",
                expected=None,
                observed="added protected core",
            )
        )
    for skill_id in sorted(baseline_records.keys() & candidate_records.keys()):
        before = baseline_records[skill_id]
        after = candidate_records[skill_id]
        for field in sorted(SKILL_FIELDS - {"id"}):
            if not strict_equal(before.get(field), after.get(field)):
                findings.append(
                    finding(
                        "REGISTRY_DRIFT",
                        skill_id=skill_id,
                        field=field,
                        expected=before.get(field),
                        observed=after.get(field),
                    )
                )
    return findings
def compare_inventory(
    registry: dict[str, Any], inventory: dict[str, Any], platform: str
) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    if inventory.get("platform") != platform:
        findings.append(
            finding(
                "INVALID_INVENTORY",
                platform=platform,
                field="platform",
                expected=platform,
                observed=inventory.get("platform"),
            )
        )
    records = inventory.get("skills")
    if not isinstance(records, list):
        return findings + [
            finding(
                "INVALID_INVENTORY",
                platform=platform,
                field="skills",
                expected="array",
            )
        ]
    for skill_id in sorted(duplicate_ids(records)):
        findings.append(
            finding("DUPLICATE_ID", skill_id=skill_id, platform=platform, field="id")
        )
    expected = {item["id"]: item for item in registry["skills"]}
    observed = {
        item["id"]: item
        for item in records
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    for skill_id in sorted(expected.keys() - observed.keys()):
        findings.append(
            finding("MISSING_PROTECTED", skill_id=skill_id, platform=platform)
        )
    for skill_id in sorted(observed.keys() - expected.keys()):
        record = observed[skill_id]
        if record.get("classification") != "custom":
            findings.append(
                finding(
                    "UNEXPECTED_CORE", skill_id=skill_id, platform=platform
                )
            )
        elif record.get("core") is not False or record.get("protected") is not False:
            findings.append(
                finding(
                    "CUSTOM_PROTECTION_FORBIDDEN",
                    skill_id=skill_id,
                    platform=platform,
                )
            )
    for skill_id in sorted(expected.keys() & observed.keys()):
        expected_record = expected[skill_id]
        observed_record = observed[skill_id]
        if observed_record.get("classification") == "custom":
            findings.append(
                finding(
                    "CUSTOM_CORE_COLLISION",
                    skill_id=skill_id,
                    platform=platform,
                )
            )
            continue
        for field in SEMANTIC_FIELDS:
            expected_value = field_value(expected_record, field)
            observed_value = field_value(observed_record, field)
            if not strict_equal(expected_value, observed_value):
                findings.append(
                    finding(
                        "SEMANTIC_DRIFT",
                        skill_id=skill_id,
                        platform=platform,
                        field=field,
                        expected=expected_value,
                        observed=observed_value,
                    )
                )
    return findings
def output(status: str, success: bool, findings: list[dict[str, Any]]) -> None:
    print(
        json.dumps(
            {"findings": findings, "status": status, "success": success},
            sort_keys=True,
            separators=(",", ":"),
        )
    )
def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="Read-only CMA core-skill governance validation."
    )
    commands = root.add_subparsers(dest="command", required=True)
    validate = commands.add_parser("validate")
    validate.add_argument("--registry", required=True, type=Path)
    compare_registry = commands.add_parser("compare-registry")
    compare_registry.add_argument("--baseline", required=True, type=Path)
    compare_registry.add_argument("--candidate", required=True, type=Path)
    compare_variants = commands.add_parser("compare-variants")
    compare_variants.add_argument("--registry", required=True, type=Path)
    for platform in PLATFORMS:
        compare_variants.add_argument(f"--{platform}", required=True, type=Path)
    return root
def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "validate":
            findings = validate_registry(load_json(args.registry))
        elif args.command == "compare-registry":
            findings = compare_registries(
                load_json(args.baseline), load_json(args.candidate)
            )
        else:
            registry = load_json(args.registry)
            findings = validate_registry(registry)
            if not findings:
                for platform in PLATFORMS:
                    inventory = load_json(getattr(args, platform))
                    findings.extend(compare_inventory(registry, inventory, platform))
    except InputError as error:
        output(
            "invalid",
            False,
            [finding("INVALID_INPUT", observed=str(error))],
        )
        return 2
    if findings:
        output("failed", False, findings)
        return 1
    output("passed", True, [])
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
