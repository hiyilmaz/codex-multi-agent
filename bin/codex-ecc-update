#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-ecc-update [--ecc-root <path>] [--codex-home <path>]

Updates the base ECC root. ECC_ROOT must be a git clone of:
https://github.com/affaan-m/everything-claude-code

This command does not rewrite project files or user custom content.
EOF
}

ECC_ROOT="$HOME/Codex-ECC"
CODEX_HOME="$HOME/.codex"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ecc-root)
      ECC_ROOT="$2"
      shift 2
      ;;
    --codex-home)
      CODEX_HOME="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ ! -d "$ECC_ROOT/.git" ]]; then
  echo "FAILED: ECC_ROOT must be a git clone of everything-claude-code: $ECC_ROOT" >&2
  echo "Expected remote: https://github.com/affaan-m/everything-claude-code" >&2
  exit 1
fi

REMOTE_URL="$(git -C "$ECC_ROOT" config --get remote.origin.url || true)"
case "$REMOTE_URL" in
  *affaan-m/everything-claude-code*)
    ;;
  *)
    echo "FAILED: ECC_ROOT remote does not look like everything-claude-code: $REMOTE_URL" >&2
    exit 1
    ;;
esac

git -C "$ECC_ROOT" pull --ff-only

if [[ -e "$CODEX_HOME/AGENTS.md" ]]; then
  echo "Found: $CODEX_HOME/AGENTS.md"
else
  echo "Missing: $CODEX_HOME/AGENTS.md"
fi

if [[ -e "$CODEX_HOME/config.toml" ]]; then
  echo "Found: $CODEX_HOME/config.toml"
else
  echo "Missing: $CODEX_HOME/config.toml"
fi

echo "User-global custom content is left unchanged:"
echo "  $CODEX_HOME/rules/"
echo "  $CODEX_HOME/skills/"
echo "  $CODEX_HOME/agents/"
