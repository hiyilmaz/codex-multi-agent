#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-project-init [--variant <id>] [--reset] <project-path>

Initializes a new project or adds a runtime variant to an existing project.
Existing projects are additive by default; --reset explicitly recreates the
shared project structure.

Behavior:
  - preserves shared files when adding a variant to an existing project
  - asks for confirmation before writing
  - with --reset, archives conflicting files under
    <project>/.codex/archive/init-YYYYMMDD_HHMMSS-PID
  - writes <project>/AGENTS.md only for a new project or explicit reset
  - writes the selected variant's project settings file
  - writes <project>/.codex/prompts/fill-project-configuration.md
  - for the claude variant, writes CLAUDE.md and .claude/settings.json
  - for the opencode variant, writes .opencode/opencode.json
  - records template version, runtime variant, and managed-file hashes
  - does not create project-local reusable rules/skills/agents directories
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VARIANT_ID=""
PROJECT_PATH=""
RESET="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --variant)
      if [[ $# -lt 2 ]]; then
        echo "FAILED: --variant requires a value" >&2
        exit 1
      fi
      VARIANT_ID="$2"
      shift 2
      ;;
    --reset)
      RESET="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -n "$PROJECT_PATH" ]]; then
        echo "FAILED: multiple project paths provided" >&2
        usage
        exit 1
      fi
      PROJECT_PATH="$1"
      shift
      ;;
  esac
done

if [[ -z "$PROJECT_PATH" ]]; then
  usage
  exit 1
fi

if [[ -z "$VARIANT_ID" ]]; then
  VARIANT_ID="$(awk -F= '
    $1 ~ /^[[:space:]]*default_variant[[:space:]]*$/ {
      value=$2
      gsub(/[[:space:]"]/, "", value)
      print value
      exit
    }
  ' "$TEMPLATE_DIR/variants/config.toml")"
fi

if ! "$TEMPLATE_DIR/bin/codex-user-install" --list-variants | awk -F '\t' -v id="$VARIANT_ID" '$1 == id { found=1 } END { exit !found }'; then
  echo "FAILED: unknown variant: $VARIANT_ID" >&2
  exit 1
fi

mkdir -p "$PROJECT_PATH"
PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"

PROJECT_DIRECTORIES=(
  "$PROJECT_PATH/.codex"
  "$PROJECT_PATH/.codex/archive"
  "$PROJECT_PATH/.codex/prompts"
)
if [[ "$VARIANT_ID" == "claude" ]]; then
  PROJECT_DIRECTORIES+=("$PROJECT_PATH/.claude")
elif [[ "$VARIANT_ID" == "opencode" ]]; then
  PROJECT_DIRECTORIES+=("$PROJECT_PATH/.opencode")
fi
for directory in "${PROJECT_DIRECTORIES[@]}"; do
  if [[ -L "$directory" ]]; then
    echo "FAILED: refusing symbolic link for project directory: $directory" >&2
    exit 1
  fi
  if [[ -e "$directory" && ! -d "$directory" ]]; then
    echo "FAILED: expected project directory: $directory" >&2
    exit 1
  fi
done

if [[ -L "$PROJECT_PATH/AGENTS.md" ]]; then
  echo "FAILED: refusing symbolic link for project AGENTS.md: $PROJECT_PATH/AGENTS.md" >&2
  exit 1
fi
if [[ -e "$PROJECT_PATH/AGENTS.md" && ! -f "$PROJECT_PATH/AGENTS.md" ]]; then
  echo "FAILED: project AGENTS.md is not a regular file: $PROJECT_PATH/AGENTS.md" >&2
  exit 1
fi
if [[ -f "$PROJECT_PATH/AGENTS.md" && "$RESET" != "true" ]]; then
  echo "Existing project detected; adding variant without resetting shared files."
  exec "$TEMPLATE_DIR/bin/codex-project-upgrade" \
    --apply \
    --add-variant \
    --variant "$VARIANT_ID" \
    "$PROJECT_PATH"
fi
if [[ -e "$PROJECT_PATH/.codex/template-state.json" && "$RESET" != "true" ]]; then
  echo "FAILED: template state exists without AGENTS.md; use --reset only for an intentional recovery reset" >&2
  exit 1
fi

TIMESTAMP="$(date +%Y%m%d_%H%M%S)-$$"
ARCHIVE_DIR="$PROJECT_PATH/.codex/archive/init-$TIMESTAMP"

CONFLICTS=(
  "AGENTS.md"
  "AGENTS.codex-template.md"
  ".codex/config.toml"
  ".codex/template-state.json"
  ".codex/agents"
  ".codex/prompts"
  ".codex/rules"
  ".codex/skills"
  ".agents"
)

if [[ "$RESET" == "true" ]]; then
  CONFLICTS+=(
    "CLAUDE.md"
    ".claude/settings.json"
    ".opencode/opencode.json"
  )
elif [[ "$VARIANT_ID" == "claude" ]]; then
  CONFLICTS+=(
    "CLAUDE.md"
    ".claude/settings.json"
  )
elif [[ "$VARIANT_ID" == "opencode" ]]; then
  CONFLICTS+=(".opencode/opencode.json")
fi

if [[ "$RESET" == "true" ]]; then
  echo "This will explicitly reset the project runtime structure."
else
  echo "This will initialize a new project runtime structure."
fi
echo "Target: $PROJECT_PATH"
echo "Archive: $ARCHIVE_DIR"
echo
echo "Items that will be archived if present:"
for item in "${CONFLICTS[@]}"; do
  if [[ -e "$PROJECT_PATH/$item" || -L "$PROJECT_PATH/$item" ]]; then
    echo "  - $item"
  fi
done
echo
printf "Continue? [y/N] "
read -r answer

case "$answer" in
  y|Y|yes|YES)
    ;;
  *)
    echo "Cancelled."
    exit 0
    ;;
esac

mkdir -p "$ARCHIVE_DIR"
chmod 700 "$ARCHIVE_DIR"

for item in "${CONFLICTS[@]}"; do
  source_path="$PROJECT_PATH/$item"
  if [[ -e "$source_path" || -L "$source_path" ]]; then
    target_path="$ARCHIVE_DIR/$item"
    mkdir -p "$(dirname "$target_path")"
    mv "$source_path" "$target_path"
    echo "Archived: $item"
  fi
done

mkdir -p "$PROJECT_PATH/.codex/prompts"

cp "$TEMPLATE_DIR/PROJECT_AGENTS_TEMPLATE.md" "$PROJECT_PATH/AGENTS.md"
cp "$TEMPLATE_DIR/PROJECT_CONFIG_PROMPT.md" "$PROJECT_PATH/.codex/prompts/fill-project-configuration.md"
if [[ "$VARIANT_ID" == "opencode" ]]; then
  mkdir -p "$PROJECT_PATH/.opencode"
  cp "$TEMPLATE_DIR/OPENCODE_PROJECT_CONFIG_EXAMPLE.json" "$PROJECT_PATH/.opencode/opencode.json"
elif [[ "$VARIANT_ID" == "codex" || "$VARIANT_ID" == "dolphin" ]]; then
  cp "$TEMPLATE_DIR/CODEX_CONFIG_EXAMPLE.toml" "$PROJECT_PATH/.codex/config.toml"
fi
if [[ "$VARIANT_ID" == "claude" ]]; then
  mkdir -p "$PROJECT_PATH/.claude"
  cp "$TEMPLATE_DIR/PROJECT_CLAUDE_TEMPLATE.md" "$PROJECT_PATH/CLAUDE.md"
  cp "$TEMPLATE_DIR/CLAUDE_SETTINGS_EXAMPLE.json" "$PROJECT_PATH/.claude/settings.json"
fi
"$TEMPLATE_DIR/bin/codex-project-upgrade" --record-initial-state --variant "$VARIANT_ID" "$PROJECT_PATH" >/dev/null

echo "Created: $PROJECT_PATH/AGENTS.md"
if [[ "$VARIANT_ID" == "opencode" ]]; then
  echo "Created: $PROJECT_PATH/.opencode/opencode.json"
elif [[ "$VARIANT_ID" == "codex" || "$VARIANT_ID" == "dolphin" ]]; then
  echo "Created: $PROJECT_PATH/.codex/config.toml"
fi
echo "Created: $PROJECT_PATH/.codex/prompts/fill-project-configuration.md"
if [[ "$VARIANT_ID" == "claude" ]]; then
  echo "Created: $PROJECT_PATH/CLAUDE.md"
  echo "Created: $PROJECT_PATH/.claude/settings.json"
fi
echo "Created: $PROJECT_PATH/.codex/template-state.json"

if [[ "$VARIANT_ID" == "claude" && ! -e "$HOME/.claude/registry/CMA_GLOBAL.md" ]]; then
  echo "Warning: the default Claude runtime is missing. Install it with codex-user-install --variant claude." >&2
elif [[ "$VARIANT_ID" == "opencode" && ! -e "$HOME/.llm-runtimes/opencode/AGENTS.md" ]]; then
  echo "Warning: the default OpenCode runtime is missing. Install it with codex-user-install --variant opencode." >&2
elif [[ "$VARIANT_ID" != "claude" && "$VARIANT_ID" != "opencode" && ! -e "$HOME/.codex/AGENTS.md" ]]; then
  echo "Warning: ~/.codex/AGENTS.md is missing. Create the user-global Codex surface first." >&2
fi

echo "Next: run the prompt in $PROJECT_PATH/.codex/prompts/fill-project-configuration.md to fill AGENTS.md Project Configuration."
