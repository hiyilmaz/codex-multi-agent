    "purpose": ("canonical-skill.Purpose", ["SKILL.md.body.Purpose", "SKILL.md.frontmatter.description"]),
    "use_when": ("canonical-skill.Use When", ["SKILL.md.body.Use When", "SKILL.md.frontmatter.description"]),
