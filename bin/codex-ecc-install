#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-ecc-install [--ecc-root <path>] [--codex-home <path>] [--force-global-agents] [--force-config]

Installs the Codex/ECC global surface.

Defaults:
  ECC_ROOT=~/Codex-ECC
  CODEX_HOME=~/.codex

Behavior:
  - requires ECC_ROOT to be a git clone of everything-claude-code
  - creates ~/.codex and user-global rules/skills/agents directories
  - installs ~/.codex/AGENTS.md if missing
  - installs ~/.codex/config.toml if missing
  - never overwrites existing files unless a force flag is provided
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ECC_ROOT="$HOME/Codex-ECC"
CODEX_HOME="$HOME/.codex"
FORCE_AGENTS="false"
FORCE_CONFIG="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ecc-root)
      ECC_ROOT="$2"
      shift 2
      ;;
    --codex-home)
      CODEX_HOME="$2"
      shift 2
      ;;
    --force-global-agents)
      FORCE_AGENTS="true"
      shift
      ;;
    --force-config)
      FORCE_CONFIG="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ ! -d "$ECC_ROOT/.git" ]]; then
  echo "FAILED: ECC_ROOT must be a git clone of everything-claude-code: $ECC_ROOT" >&2
  echo "Expected remote: https://github.com/affaan-m/everything-claude-code" >&2
  exit 1
fi

REMOTE_URL="$(git -C "$ECC_ROOT" config --get remote.origin.url || true)"
case "$REMOTE_URL" in
  *affaan-m/everything-claude-code*)
    ;;
  *)
    echo "FAILED: ECC_ROOT remote does not look like everything-claude-code: $REMOTE_URL" >&2
    exit 1
    ;;
esac

mkdir -p "$CODEX_HOME/rules" "$CODEX_HOME/skills" "$CODEX_HOME/agents"

GLOBAL_AGENTS="$CODEX_HOME/AGENTS.md"
if [[ ! -e "$GLOBAL_AGENTS" || "$FORCE_AGENTS" == "true" ]]; then
  cp "$TEMPLATE_DIR/GLOBAL_AGENTS_TEMPLATE.md" "$GLOBAL_AGENTS"
  perl -0pi -e "s#ECC_ROOT: ~/Codex-ECC#ECC_ROOT: $ECC_ROOT#g" "$GLOBAL_AGENTS"
  echo "Installed: $GLOBAL_AGENTS"
else
  echo "Skipped existing: $GLOBAL_AGENTS"
fi

GLOBAL_CONFIG="$CODEX_HOME/config.toml"
if [[ ! -e "$GLOBAL_CONFIG" || "$FORCE_CONFIG" == "true" ]]; then
  cp "$TEMPLATE_DIR/CODEX_CONFIG_EXAMPLE.toml" "$GLOBAL_CONFIG"
  perl -0pi -e "s#ECC_ROOT=~/Codex-ECC#ECC_ROOT=$ECC_ROOT#g" "$GLOBAL_CONFIG"
  echo "Installed: $GLOBAL_CONFIG"
else
  echo "Skipped existing: $GLOBAL_CONFIG"
fi

echo "ECC_ROOT: $ECC_ROOT"
echo "CODEX_HOME: $CODEX_HOME"
