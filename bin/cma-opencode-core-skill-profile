def validate_registry_authority(registry: dict[str, Any]) -> list[dict[str, Any]]:
    try:
        script = Path(__file__).resolve(strict=True)
        bin_root = script.parent
        path = bin_root / "cma-core-skill-governance"
        if path.is_symlink():
            raise InputError("canonical registry validator unavailable or invalid")
        resolved = path.resolve(strict=True)
        metadata = resolved.stat()
        if (
            resolved != path or resolved.parent != bin_root
            or not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 1_048_576
        ):
            raise InputError("canonical registry validator unavailable or invalid")
        namespace: dict[str, Any] = {
            "__file__": str(resolved), "__name__": "cma_core_skill_governance",
            "__package__": None,
        }
        exec(compile(resolved.read_bytes(), str(resolved), "exec"), namespace)
        validator = namespace.get("validate_registry")
        if not callable(validator):
            raise InputError("canonical registry validator unavailable or invalid")
        raw_findings = validator(registry)
        if not isinstance(raw_findings, list):
            raise InputError("canonical registry validator unavailable or invalid")
        findings: list[dict[str, Any]] = []
        for item in raw_findings:
            if not isinstance(item, dict) or not isinstance(item.get("code"), str):
                raise InputError("canonical registry validator unavailable or invalid")
            safe = {"code": item["code"]}
            if item.get("field") is not None:
                if not isinstance(item["field"], str):
                    raise InputError("canonical registry validator unavailable or invalid")
                safe["field"] = item["field"]
            findings.append(safe)
        return findings
    except InputError:
        raise
    except Exception:
        raise InputError("canonical registry validator unavailable or invalid") from None


def validate_profile(profile: dict[str, Any], registry: dict[str, Any]) -> list[dict[str, Any]]:
    findings = validate_registry_authority(registry)
    if set(profile) != TOP_LEVEL_FIELDS:
        findings.append(finding("INVALID_PROFILE_SCHEMA", "top_level_fields"))
    identity = (
        ("schema_version", "cma-opencode-core-skill-profile/v1"),
        ("platform", "opencode"), ("profile_version", "1.0.0"),
    )
    for field, expected in identity:
        if not strict_equal(expected, profile.get(field)):
            findings.append(finding("INVALID_PROFILE_SCHEMA", field))
    mappings = profile.get("field_mappings")
    if not isinstance(mappings, list):
        findings.append(finding("INVALID_PROFILE_SCHEMA", "field_mappings"))
        mappings = []
    names = [item.get("canonical_field") for item in mappings if isinstance(item, dict)]
    for name in CANONICAL_FIELDS:
        count = sum(type(value) is str and value == name for value in names)
        if count == 0:
            findings.append(finding("MISSING_MAPPING", name))
        elif count > 1:
            findings.append(finding("DUPLICATE_MAPPING", name))
    for index, item in enumerate(mappings):
        if not isinstance(item, dict) or set(item) != {"canonical_field", "canonical_source", "opencode_targets"}:
            findings.append(finding("UNKNOWN_MAPPING", f"field_mappings[{index}]"))
            continue
        name = item["canonical_field"]
        if not isinstance(name, str) or name not in MAPPING_CONTRACT:
            findings.append(finding("UNKNOWN_MAPPING", f"field_mappings[{index}].canonical_field"))
            continue
        expected_source, expected_targets = MAPPING_CONTRACT[name]
        if not strict_equal(expected_source, item.get("canonical_source")):
            findings.append(finding("CANONICAL_AUTHORITY_VIOLATION", name))
        if not strict_equal(expected_targets, item.get("opencode_targets")):
            findings.append(finding("UNSUPPORTED_OPENCODE_MAPPING", name))
    for field, (expected, code) in expected_sections().items():
        observed = profile.get(field)
        if strict_equal(expected, observed):
            continue
        if field == "native_skill" and isinstance(observed, dict):
            optional = observed.get("frontmatter", {}).get("optional") if isinstance(observed.get("frontmatter"), dict) else None
            if isinstance(optional, list) and "slash" in optional:
                code = "UNSUPPORTED_V2_FIELD"
        if field == "activation" and isinstance(observed, dict) and observed.get("disabled_core_ids"):
            findings.append(finding("CORE_DISABLE_FORBIDDEN", "activation.disabled_core_ids"))
        findings.append(finding(code, field))
    return findings


def canonical_fingerprint(
    profile: dict[str, Any], registry: dict[str, Any],
    native_metadata: dict[str, Any] | None = None,
) -> str:
    findings = validate_profile(profile, registry)
    if findings:
        raise InputError("invalid profile")
    metadata = {} if native_metadata is None else native_metadata
    if not isinstance(metadata, dict) or set(metadata) - NONSEMANTIC_METADATA:
        raise InputError("behavioral or unknown native metadata")
    for key in ("license", "compatibility"):
        if key in metadata and not isinstance(metadata[key], str):
            raise InputError("native metadata values must be strings")
    nested = metadata.get("metadata", {})
    if not isinstance(nested, dict) or not all(
        isinstance(key, str) and isinstance(value, str) for key, value in nested.items()
    ):
        raise InputError("native metadata must be a string-to-string map")
    if any(key in {"opencode/slash", "opencode/autoinvoke"} for key in nested):
        raise InputError("unsupported V2 metadata")
    payload = {
        "mappings": profile["field_mappings"],
        "activation": profile["activation"],
        "unavailable": profile["tool_unavailable_behavior"],
        "routing": profile["global_instructions"],
        "registry_skills": registry["skills"],
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def emit(status: str, success: bool, findings: list[dict[str, Any]]) -> None:
    payload = {"findings": findings, "status": status, "success": success}
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Read-only CMA OpenCode core-skill profile validation."
    )
    commands = parser.add_subparsers(dest="command", required=True)
    validate = commands.add_parser("validate")
    validate.add_argument("--profile", required=True, type=Path)
    validate.add_argument("--registry", required=True, type=Path)
    args = parser.parse_args()
    try:
        findings = validate_profile(load_json(args.profile), load_json(args.registry))
    except InputError:
        emit("invalid", False, [finding("INVALID_INPUT")])
        return 2
    if findings:
        emit("failed", False, findings)
        return 1
    emit("passed", True, [])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
