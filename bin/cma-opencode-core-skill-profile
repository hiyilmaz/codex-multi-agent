    "prohibited_operations",
}
OFFICIAL_SOURCES = [
    "https://opencode.ai/docs/skills", "https://opencode.ai/docs/config/",
    "https://opencode.ai/docs/rules/", "https://opencode.ai/docs/agents",
    "https://opencode.ai/docs/mcp-servers/", "https://opencode.ai/docs/plugins/",
    "https://opencode.ai/v2/docs/migrate-v1",
]
NONSEMANTIC_METADATA = {"license", "compatibility", "metadata"}
MAX_INPUT_BYTES = 1_048_576
MAX_JSON_DEPTH = 64
MAX_JSON_NODES = 50_000


class InputError(ValueError):
    """Raised when input cannot be safely interpreted."""


def strict_equal(left: Any, right: Any) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return left.keys() == right.keys() and all(
            strict_equal(value, right[key]) for key, value in left.items()
        )
    if isinstance(left, list):
        return len(left) == len(right) and all(
            strict_equal(a, b) for a, b in zip(left, right)
        )
    return left == right


def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise InputError("duplicate JSON key")
        result[key] = value
    return result


def validate_json_shape(value: Any) -> None:
    stack = [(value, 0)]
    nodes = 0
    while stack:
        current, depth = stack.pop()
        nodes += 1
        if nodes > MAX_JSON_NODES or depth > MAX_JSON_DEPTH:
            raise InputError("JSON input exceeds structural limits")
        if isinstance(current, dict):
            stack.extend((item, depth + 1) for item in current.values())
        elif isinstance(current, list):
            stack.extend((item, depth + 1) for item in current)


def load_json(path: Path) -> dict[str, Any]:
    try:
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags | nofollow)
        with os.fdopen(descriptor, "rb") as handle:
            opened = os.fstat(handle.fileno())
            current = os.lstat(path)
            same_file = (opened.st_dev, opened.st_ino) == (current.st_dev, current.st_ino)
            if (
                not same_file or not stat.S_ISREG(opened.st_mode)
                or not stat.S_ISREG(current.st_mode)
                or opened.st_size > MAX_INPUT_BYTES
                or current.st_size > MAX_INPUT_BYTES
            ):
                raise InputError("JSON input exceeds file limits")
            raw = handle.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            raise InputError("JSON input exceeds file limits")
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
        validate_json_shape(value)
    except (OSError, UnicodeError, json.JSONDecodeError, RecursionError, InputError):
        raise InputError("invalid JSON input") from None
    if not isinstance(value, dict):
        raise InputError("JSON input must be an object")
    return value


def finding(code: str, field: str | None = None) -> dict[str, Any]:
    item: dict[str, Any] = {"code": code}
    if field is not None:
        item["field"] = field
    return item


