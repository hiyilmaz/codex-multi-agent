TOP_LEVEL_FIELDS = {
    "schema_version", "platform", "profile_version", "canonical_sources",
    "documentation", "runtime_target", "native_skill", "discovery",
    "activation", "protected_identification", "field_mappings",
    "opencode_metadata", "tool_unavailable_behavior", "global_instructions",
