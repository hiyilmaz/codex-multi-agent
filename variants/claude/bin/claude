#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ -d "$RUNTIME_ROOT/home" ]]; then
  CLAUDE_RUNTIME_HOME="$RUNTIME_ROOT/home"
else
  CLAUDE_RUNTIME_HOME="$RUNTIME_ROOT"
fi

export CLAUDE_CONFIG_DIR="$CLAUDE_RUNTIME_HOME"

NATIVE_CLAUDE="$(command -v claude || true)"
if [[ -z "$NATIVE_CLAUDE" || "$NATIVE_CLAUDE" == "$0" ]]; then
  echo "FAILED: native claude binary was not found in PATH" >&2
  exit 127
fi

exec "$NATIVE_CLAUDE" "$@"
