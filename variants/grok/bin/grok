#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ -d "$RUNTIME_ROOT/home" ]]; then
  RUNTIME_HOME="$RUNTIME_ROOT/home"
else
  RUNTIME_HOME="$RUNTIME_ROOT"
fi

NATIVE_GROK="$(command -v grok || true)"
if [[ -z "$NATIVE_GROK" || "$NATIVE_GROK" -ef "${BASH_SOURCE[0]}" ]]; then
  echo "FAILED: native grok executable was not found in PATH or resolves to this launcher." >&2
  exit 127
fi

export GROK_HOME="$RUNTIME_HOME"
exec "$NATIVE_GROK" --no-auto-update "$@"
