#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${BASH_VERSION:-}" ]]; then
  script_path="${BASH_SOURCE[0]}"
  is_executed="false"
  [[ "${BASH_SOURCE[0]}" == "$0" ]] && is_executed="true"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  script_path="${(%):-%x}"
  is_executed="false"
else
  script_path="$0"
  is_executed="true"
fi

SCRIPT_DIR="$(cd "$(dirname "$script_path")" && pwd)"
DOLPHIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$DOLPHIN_ROOT/.." && pwd)"

default_agent_home="$DOLPHIN_ROOT/agent-home"
if [[ "$PWD" == "$REPO_ROOT" ]]; then
  default_agent_home="DolphinVersion/agent-home"
fi

export AGENT_HOME="${AGENT_HOME:-$default_agent_home}"
export MODEL_API_BASE_URL="${MODEL_API_BASE_URL:-https://lm.backstage8.com/v1/}"
export MODEL_ID="${MODEL_ID:-cognitivecomputations_dolphin-mistral-24b-venice-edition}"

models_url="${MODEL_API_BASE_URL%/}/models"

if command -v curl >/dev/null 2>&1; then
  if ! curl --silent --fail --max-time 10 "$models_url" >/dev/null; then
    echo "WARNING: model endpoint did not respond: $models_url" >&2
  fi
else
  echo "WARNING: curl not found; skipping model endpoint check" >&2
fi

if [[ "$is_executed" == "true" ]]; then
  cat <<EOF
export AGENT_HOME="$AGENT_HOME"
export MODEL_API_BASE_URL="$MODEL_API_BASE_URL"
export MODEL_ID="$MODEL_ID"
EOF
else
  echo "Prepared DolphinVersion environment:"
  echo "AGENT_HOME=$AGENT_HOME"
  echo "MODEL_API_BASE_URL=$MODEL_API_BASE_URL"
  echo "MODEL_ID=$MODEL_ID"
fi
